# MotionIQ Full-Stack Environment Template
# ========================================

# Backend FastAPI Settings
HOST=0.0.0.0
PORT=8000
DEBUG=False
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Rate Limiting & Video Ingestion Limits
MAX_FRAMES_PER_SECOND=30
DETECTION_DEBUG_LOG=False
UPLOAD_DIR=./uploads
CHUNK_DIR=./uploads/chunks
MAX_FILE_SIZE=104857600
CHUNK_SIZE=5242880

# Frontend Next.js Public Endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
