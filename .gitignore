# ==============================================================================
# MotionIQ Root .gitignore
# ==============================================================================

# Python & Virtual Environments
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!frontend/src/lib/
!frontend/src/lib/**
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linting
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
htmlcov/
.mypy_cache/
.ruff_cache/

# Node.js, Frontend & Build Artifacts
node_modules/
*/node_modules/
.next/
*/.next/
out/
*/out/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# Sensitive Environment Variables & Credentials
.env
.env.*
*.env
!*.env.example
!**/.env.example

# External Datasets (Redistribution Prohibited - See docs/DATASET_AND_LICENSES.md)
# Datasets are programmatically acquired via research/data/acquire_uiprmd.py
research/data/uiprmd/
research/data/**/*.txt
research/data/**/*.csv
!research/data/*.py
!research/data/*.md
!research/data/REAL_DATA_MANIFEST.md

# Cloned Upstream Reference Repositories
upstream/

# Logs & Ephemeral Artifacts
*.log
research/artifacts/*.log
research/artifacts/**/inputs/
research/artifacts/**/*.zip

# Uploads & User Media (Zero Private Video Storage)
uploads/*
!uploads/.gitkeep
uploads/chunks/*
!uploads/chunks/.gitkeep
*.mp4
*.mov
*.avi
*.webm
*.mkv
*.wav
*.mp3

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
